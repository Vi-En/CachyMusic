pkgname=cachymusic
pkgver=3.0.0.dev6.42
pkgrel=1
pkgdesc='Local-first music player with optional DSP and Soulseek'
arch=('any')
url='https://github.com/Vi-En/CachyMusic'
license=('GPL-3.0-or-later')
depends=('php' 'python')
optdepends=('chromium: standalone browser window and current Web Audio support'
            'xdg-utils: default browser fallback'
            'php-sqlite: SQLite library storage (JSON fallback available)'
            'python-dbus: optional Linux MPRIS bridge'
            'python-gobject: optional MPRIS and tray'
            'gtk3: optional tray'
            'libayatana-appindicator: optional tray'
            'zenity: GTK native folder chooser'
            'kdialog: KDE native folder chooser'
            'nodejs: optional Soulseek (requires separately installed slsk-client)'
            'ffmpeg: metadata and cover extraction'
            'wireplumber: PipeWire system volume bridge'
            'libpulse: PulseAudio volume bridge'
            'alsa-utils: ALSA mixer fallback')
source=("${pkgname}-${pkgver}.tar.gz")
# Replaced with actual source hash by prepare-source.sh; template is not a release recipe.
sha256sums=('SOURCE_SHA256')
package() {
    cd "${srcdir}/${pkgname}-${pkgver}"
    install -dm755 "${pkgdir}/usr/share/cachymusic" "${pkgdir}/usr/bin"
    cp -r index.html index.php manifest.json sw.js schema.sql LICENSE package.json resources scripts stylesheets php bin server "${pkgdir}/usr/share/cachymusic/"
    chmod 755 "${pkgdir}/usr/share/cachymusic/bin/cachymusic"
    ln -s /usr/share/cachymusic/bin/cachymusic "${pkgdir}/usr/bin/cachymusic"
    install -Dm644 packaging/aur/cachymusic.desktop "${pkgdir}/usr/share/applications/cachymusic.desktop"
    install -Dm644 resources/images/icon-512.png "${pkgdir}/usr/share/icons/hicolor/512x512/apps/cachymusic.png"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
