{
  "id": "com.cachymusic.audioworkstation",
  "name": "CachyMusic",
  "short_name": "CachyMusic",
  "description": "Local-first high-fidelity music player with optional audio processing",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#09090d",
  "theme_color": "#09090d",
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "categories": [
    "music",
    "audio",
    "entertainment",
    "utilities"
  ],
  "icons": [
    {
      "src": "resources/images/app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "resources/images/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "resources/images/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "resources/images/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "resources/images/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "audio/flac": [".flac"],
        "audio/mpeg": [".mp3"],
        "audio/wav": [".wav"],
        "audio/ogg": [".ogg", ".opus"],
        "audio/mp4": [".m4a", ".mp4"],
        "audio/aac": [".aac"],
        "audio/webm": [".webm"],
        "audio/x-aiff": [".aif", ".aiff"]
      }
    }
  ],
  "shortcuts": [
    {
      "name": "Library",
      "short_name": "Library",
      "description": "View all tracks and playlists",
      "url": "./index.html#library",
      "icons": [
        {
          "src": "resources/images/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Parametric Equalizer",
      "short_name": "EQ & DSP",
      "description": "Open the parametric equalizer and audio processing settings",
      "url": "./index.html#peq",
      "icons": [
        {
          "src": "resources/images/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Soulseek Studio",
      "short_name": "Soulseek",
      "description": "P2P lossless music discovery and transfer studio",
      "url": "./index.html#soulseek",
      "icons": [
        {
          "src": "resources/images/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}
